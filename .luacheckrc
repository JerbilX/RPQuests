-- Luacheck configuration for RPQuest (ESO Lua 5.1 / LuaJIT)
std = "luajit"
max_line_length = false
self = false

exclude_files = {
    "tests/**",
}

-- Addon global namespace and EsoUI tables mutated by addon registration
globals = {
    "RPQuest",
    "ESO_Dialogs",
    "ZO_MapPin",
}

-- Official Elder Scrolls Online (EsoUI) read-only globals
read_globals = {
    -- Core & Debug
    "d",
    "zo_callLater",
    "zo_strformat",

